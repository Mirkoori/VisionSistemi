# Copia in .env oppure imposta queste variabili sul server.
ADMIN_PIN=scegli-un-pin-lungo      # serve per creare eventi da /nuovo. Se manca, non si possono creare eventi.
PORT=3000
MAX_FILE_MB=500                    # dimensione massima di un file
EVENT_QUOTA_MB=4096                # spazio massimo per evento
TRUST_PROXY=1                      # metti 1 se il server sta dietro a nginx o Caddy
